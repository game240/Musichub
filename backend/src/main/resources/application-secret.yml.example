# Copy this file to application-secret.yml and fill in your actual credentials.
# application-secret.yml is excluded from git tracking.
spring:
  mail:
    username: your-email@gmail.com
    password: your-16-digit-app-password

musichub:
  storage:
    r2:
      access-key: YOUR_R2_ACCESS_KEY
      secret-key: YOUR_R2_SECRET_KEY
